# build
/build/
.gradle/
*.class
*.jar
!third_party/**/*.jar

# IDE and agent scratch
.idea/
*.iml
.vscode/

# the other languages' packages, once they exist
web/node_modules/
web/.next/
agent-runner/**/__pycache__/
agent-runner/.venv/

# nothing an applicant submitted, no snapshot, no run output, ever (E-014)
submissions/
runs/
*.tmp

# OS
.DS_Store

# the sandbox image's fetched pieces, each checked by hash (sandbox/prefetch.sh, E-041)
sandbox/cache/

# A worker agent's git worktree (docs/how/hand-out-a-task.md): another checkout of this repository, never part of it
.claude/worktrees/
